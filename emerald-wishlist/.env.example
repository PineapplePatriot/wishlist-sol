# Copy this file to ".env" and fill in your real Supabase values.
# Find them in Supabase: Project Settings → Data API (URL) and API Keys (anon/public key).
# The "anon" key is safe for the browser. NEVER put the service_role / secret key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
